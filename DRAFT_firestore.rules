rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 2. Users collection validation
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.id == request.auth.uid;
      allow create: if isSignedIn() && isOwner(userId)
                    && request.resource.data.id == userId
                    && request.resource.data.email is string
                    && request.resource.data.fullName is string;
      allow update: if isSignedIn() && isOwner(userId)
                    && request.resource.data.id == userId
                    && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    // 3. Grammar progress collection
    match /grammar_progress/{progressId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.topicId is string
                    && request.resource.data.completed is bool;
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.topicId == resource.data.topicId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 4. Grammar SRS collection
    match /grammar_srs/{srsId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.topicId is string;
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
