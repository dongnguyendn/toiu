{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account information and profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The unique user ID" },
        "fullName": { "type": "string", "description": "Full name of the user" },
        "email": { "type": "string", "description": "Email address of the user" },
        "level": { "type": "string", "description": "Active learning CEFR level" },
        "xp": { "type": "integer", "description": "Experiential Points accumulated" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["id", "fullName", "email"]
    },
    "GrammarProgress": {
      "title": "GrammarProgress",
      "description": "Information about a user's progress on a grammar topic.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The user ID" },
        "topicId": { "type": "string", "description": "The grammar topic ID" },
        "completed": { "type": "boolean", "description": "Whether the topic is completed" },
        "score": { "type": "integer", "description": "Latest quiz score" },
        "lastStudied": { "type": "string", "format": "date-time", "description": "Last studied timestamp" }
      },
      "required": ["userId", "topicId", "completed"]
    },
    "GrammarSrsCard": {
      "title": "GrammarSrsCard",
      "description": "SRS flashcard for grammar topics for spaced repetition, due reviews, and mastery.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The SRS Card ID" },
        "userId": { "type": "string", "description": "The user ID" },
        "topicId": { "type": "string", "description": "The topic ID" },
        "interval": { "type": "integer", "description": "Spaced repetition active interval in days" },
        "easeFactor": { "type": "number", "description": "Card difficulty ease factor" },
        "nextReviewDate": { "type": "string", "format": "date-time", "description": "The date when this card is next due" }
      },
      "required": ["id", "userId", "topicId", "interval"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profile documents."
    },
    "/grammar_progress/{progressId}": {
      "schema": "GrammarProgress",
      "description": "Collection of grammar learning progresses."
    },
    "/grammar_srs/{srsId}": {
      "schema": "GrammarSrsCard",
      "description": "Spaced repetition cards for grammar mastery."
    }
  }
}
